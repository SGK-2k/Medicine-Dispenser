/**
 * @file MediDispense_Firmware_FileReference.dox
 * @brief Complete Arduino firmware for the MediDispense medicine dispenser.
 *
 * @details
 * This firmware controls the complete embedded medicine-dispenser workflow:
 * keypad input, MFRC522 RFID authentication, I2C LCD output, three servo-driven
 * medicine boxes, three IR presence sensors, access control, prescription
 * storage, refill/reset sequences, dispensing, access history, and the USB
 * serial protocol used by the doctor GUI.
 *
 * The software is organized using object-oriented abstractions, linked
 * data structures, an event bus, authentication strategies, and a state
 * pattern for the dispenser workflow.
 *
 * @author P I SAI MATHESH
 * @author S GOPALAKRISHNAN
 * @version 5
 * @date 2026
 */
#include <Wire.h>
#include <SPI.h>
#include <MFRC522.h>
#include <Servo.h>
#include <LiquidCrystal_I2C.h>

#define FIRMWARE_VERSION "5"

// ======================================================
// 1. PIN DEFINITIONS
// ======================================================
// WIRING SUMMARY (Pico W GP number -> physical pin)
//   Keypad rows R1-R4    GP0, GP1, GP2, GP3      (pins 1, 2, 4, 5)
//   Keypad cols C1-C4    GP12, GP13, GP14, GP15  (pins 16, 17, 19, 20)
//   RFID  MISO/SDA/SCK/MOSI  GP4, GP5, GP6, GP7  (pins 6, 7, 9, 10)
//   RFID  RST            GP28                    (pin 34)   RFID VCC = 3V3 only
//   LCD   SDA / SCL      GP8, GP9                (pins 11, 12)
//   Servo 1 / 2 / 3      GP16, GP17, GP18        (pins 21, 22, 24)
//   IR    1 / 2 / 3      GP19, GP20, GP21        (pins 25, 26, 27)

// RFID - SPI0
#define RFID_MISO     4
#define RFID_SS       5
#define RFID_SCK      6
#define RFID_MOSI     7
#define RFID_RST      28

// LCD - I2C0
#define LCD_SDA       8
#define LCD_SCL       9
#define LCD_ADDRESS   0x27      // change to 0x3F if your LCD uses it

// IR sensors (one per box)
#define IR_BOX1       19
#define IR_BOX2       20
#define IR_BOX3       21
#define IR_ACTIVE_LOW 0        // 1 = output goes LOW when something is detected
                                //     (FC-51 style modules). Set 0 if yours goes HIGH.

// Servos
#define SERVO_GENERAL 16
#define SERVO_SEVERE  17
#define SERVO_HIGH    18

// Servo positions (degrees) and pulse range for a full 0-180 sweep
#define SERVO_CLOSED  0
#define SERVO_OPEN    180
#define SERVO_MIN_US  500
#define SERVO_MAX_US  2500

// ======================================================
// 2. SETTINGS
// ======================================================

const char*         REFILL_CODE      = "1234";  // refill / reset passcode
const unsigned long CLOSE_DELAY      = 5000;    // ms after IR change before a box closes
const unsigned long COLLECT_TIMEOUT  = 30000;   // ms to take the medicine
const unsigned long EMPTY_CONFIRM    = 3000;    // ms all boxes must read empty in reset
const unsigned long LOGIN_TIMEOUT    = 30000;   // ms of inactivity on the login screen
const unsigned long DOCTOR_SESSION   = 900000;  // 15 min doctor session on the GUI
const int           MAX_ATTEMPTS     = 3;       // wrong tries before a lockout
const unsigned long LOCKOUT_TIME     = 10000;   // ms locked after too many tries
const unsigned long IR_DEBOUNCE      = 80;      // ms an IR reading must be stable
const uint8_t       PIN_LENGTH       = 4;
const size_t        HISTORY_SIZE     = 20;
const size_t        QUEUE_SIZE       = 16;
const int           BOX_COUNT        = 3;

const char* const BOX_NAMES[] = { "", "General", "Severe", "High Sev" };

// ------------------------------------------------------
// USER TABLE - one row per user.
// level       = highest box the user may open (1 General, 2 Severe, 3 High)
// canPrescribe = may log in on the GUI and send prescriptions
// ------------------------------------------------------
/**
 * @brief Compile-time configuration record describing an authorized dispenser user.
 */
struct UserConfig
{
    const char* name;
    const char* pin;
    const char* uid;
    int         level;
    bool        canPrescribe;
};

const UserConfig USER_TABLE[] =
{
    { "Patient",    "1111", "9DB9BE21", 1, false },
    { "Head Nurse", "3333", "F3A0EEE3", 2, false },
    { "Doctor",     "4444", "CFDE401C", 3, true  }
};

const int USER_TABLE_SIZE = sizeof(USER_TABLE) / sizeof(USER_TABLE[0]);


// ######################################################
//                  DATA STRUCTURES
// ######################################################

// ======================================================
// 3. STACK - code digits (linked nodes on the heap)
// ======================================================
/**
 * @brief Bounded linked-list stack used to collect PIN or refill-code digits.
 */
class PinStack
{
public:
    /**
     * @brief Performs the in stack operation.
     *
     * @param capacity Input/output parameter used by this operation.
     *
     * @return Result produced by the in stack operation.
     */
    explicit PinStack(uint8_t capacity) : capacity_(capacity) {}
    /**
     * @brief Performs the pin stack operation.
     *
     * @return Result produced by the pin stack operation.
     */
    ~PinStack() { clear(); }

    bool push(char digit)
    {
        if (size_ >= capacity_) return false;
        top_ = new Node{ digit, top_ };
        size_++;
        return true;
    }

    bool pop(char* out = nullptr)
    {
        if (top_ == nullptr) return false;
        Node* node = top_;
        if (out != nullptr) *out = node->digit;
        top_ = node->next;
        delete node;
        size_--;
        return true;
    }

    /**
     * @brief Removes all stored items and resets the structure to an empty state.
     */
    void clear() { while (pop()) { } }

    /**
     * @brief Returns the current number of stored items.
     *
     * @return Result produced by the size operation.
     */
    uint8_t size()  const { return size_; }
    /**
     * @brief Checks whether the structure has reached its configured capacity.
     *
     * @return Result produced by the full operation.
     */
    bool    full()  const { return size_ >= capacity_; }
    /**
     * @brief Checks whether the structure currently contains no items.
     *
     * @return Result produced by the empty operation.
     */
    bool    empty() const { return size_ == 0; }

    // Digits in typing order (bottom of the stack first)
    String toString() const
    {
        char buf[17];
        uint8_t i = size_;
        buf[i] = '\0';
        for (Node* n = top_; n != nullptr; n = n->next) buf[--i] = n->digit;
        /**
         * @brief Performs the string operation.
         *
         * @param buf Input/output parameter used by this operation.
         *
         * @return Result produced by the string operation.
         */
        return String(buf);
    }

private:
    /**
     * @brief Defines the Node struct used by the dispenser firmware.
     */
    struct Node { char digit; Node* next; };

    Node*         top_  = nullptr;
    uint8_t       size_ = 0;
    const uint8_t capacity_;
};

// ======================================================
// 4. QUEUE - generic FIFO (singly linked list)
// ======================================================
template <typename T>
/**
 * @brief Generic bounded FIFO queue implemented using a singly linked list.
 */
class Queue
{
public:
    /**
     * @brief Performs the ueue operation.
     *
     * @param capacity Input/output parameter used by this operation.
     *
     * @return Result produced by the ueue operation.
     */
    explicit Queue(size_t capacity) : capacity_(capacity) {}
    /**
     * @brief Performs the queue operation.
     *
     * @return Result produced by the queue operation.
     */
    ~Queue() { clear(); }

    bool push(const T& value)
    {
        if (size_ >= capacity_) return false;
        Node* node = new Node{ value, nullptr };
        if (tail_ != nullptr) tail_->next = node;
        else                  head_ = node;
        tail_ = node;
        size_++;
        return true;
    }

    bool pop(T& out)
    {
        if (head_ == nullptr) return false;
        Node* node = head_;
        out   = node->value;
        head_ = node->next;
        if (head_ == nullptr) tail_ = nullptr;
        delete node;
        size_--;
        return true;
    }

    void clear()
    {
        T discard;
        /**
         * @brief Performs the hile operation.
         *
         * @param discard Input/output parameter used by this operation.
         *
         * @return Result produced by the hile operation.
         */
        while (pop(discard)) { }
    }

    /**
     * @brief Checks whether the structure currently contains no items.
     *
     * @return Result produced by the empty operation.
     */
    bool   empty() const { return size_ == 0; }
    /**
     * @brief Returns the current number of stored items.
     *
     * @return Result produced by the size operation.
     */
    size_t size()  const { return size_; }

private:
    /**
     * @brief Defines the Node struct used by the dispenser firmware.
     */
    struct Node { T value; Node* next; };

    Node*        head_ = nullptr;
    Node*        tail_ = nullptr;
    size_t       size_ = 0;
    const size_t capacity_;
};

// ======================================================
// 5. INPUT EVENT - what goes through the input queue
// ======================================================
/**
 * @brief Identifies the source or meaning of an input event.
 */
enum class InputType : uint8_t
{
    Key, Card,                                  // from the dispenser
    SelectBox, Pin, Clear, Exit,                // optional, from the PC
    Hello, Status, Ping, History,               // info requests
    DocLogin, DocLogout, Prescription,          // doctor actions
    Unknown
};

/**
 * @brief Represents one normalized input event consumed by the dispenser controller.
 */
struct InputEvent
{
    InputType type = InputType::Unknown;
    char      key  = 0;
    int       box  = 0;
    String    text = "";
};

// ======================================================
// 6. USERS - singly linked list, created by a factory
// ======================================================
/**
 * @brief Runtime linked-list node containing one authorized user's credentials and access level.
 */
struct User
{
    String name;
    String pin;
    String uid;
    int    level;
    bool   canPrescribe;
    User*  next;
};

/**
 * @brief Factory responsible for constructing runtime User objects from configuration records.
 */
class UserFactory
{
public:
    static User* create(const UserConfig& cfg)
    {
        return new User{ cfg.name, cfg.pin, cfg.uid, cfg.level, cfg.canPrescribe, nullptr };
    }
};

/**
 * @brief Owns and searches the linked list of authorized users.
 */
class UserRegistry
{
public:
    ~UserRegistry()
    {
        while (head_ != nullptr)
        {
            User* next = head_->next;
            delete head_;
            head_ = next;
        }
    }

    void add(User* user)
    {
        if (user == nullptr) return;
        user->next = nullptr;
        /**
         * @brief Performs the f operation.
         *
         * @param head_ Input/output parameter used by this operation.
         *
         * @return Result produced by the f operation.
         */
        if (head_ == nullptr) { head_ = user; }
        else
        {
            User* cur = head_;
            while (cur->next != nullptr) cur = cur->next;
            cur->next = user;
        }
        count_++;
    }

    User* findByPin(const String& pin) const
    {
        for (User* u = head_; u != nullptr; u = u->next) if (u->pin == pin) return u;
        return nullptr;
    }

    User* findByUid(const String& uid) const
    {
        for (User* u = head_; u != nullptr; u = u->next) if (u->uid == uid) return u;
        return nullptr;
    }

    /**
     * @brief Performs the first operation.
     *
     * @return Result produced by the first operation.
     */
    User* first() const { return head_; }
    /**
     * @brief Performs the count operation.
     *
     * @return Result produced by the count operation.
     */
    int   count() const { return count_; }

private:
    User* head_  = nullptr;
    int   count_ = 0;
};

// ======================================================
// 7. ACCESS HISTORY - doubly linked list, newest at the tail
// ======================================================
/**
 * @brief Stores one access-control or dispenser-history event.
 */
struct AccessRecord
{
    unsigned long timeMs;
    int           box;
    String        who;
    String        method;
    String        result;   // OPENED, DENIED, FAILED, LOCKED, TIMEOUT, DISPENSED,
                            // NOTTAKEN, LOADED, EMPTIED
    AccessRecord* prev;
    AccessRecord* next;
};

/**
 * @brief Bounded history collection containing recent access records.
 */
class AccessHistory
{
public:
    /**
     * @brief Performs the ccess history operation.
     *
     * @param capacity Input/output parameter used by this operation.
     *
     * @return Result produced by the ccess history operation.
     */
    explicit AccessHistory(size_t capacity) : capacity_(capacity) {}
    /**
     * @brief Performs the access history operation.
     *
     * @return Result produced by the access history operation.
     */
    ~AccessHistory() { while (head_ != nullptr) removeOldest(); }

    void add(int box, const String& who, const String& method, const String& result)
    {
        AccessRecord* rec = new AccessRecord{ millis(), box, who, method, result, tail_, nullptr };
        if (tail_ != nullptr) tail_->next = rec;
        else                  head_ = rec;
        tail_ = rec;
        size_++;
        /**
         * @brief Performs the f operation.
         *
         * @param removeOldest Input/output parameter used by this operation.
         *
         * @return Result produced by the f operation.
         */
        if (size_ > capacity_) removeOldest();
    }

    template <typename Visitor>
    void forEachNewestFirst(Visitor visit) const
    {
        for (AccessRecord* r = tail_; r != nullptr; r = r->prev) visit(*r);
    }

    /**
     * @brief Returns the current number of stored items.
     *
     * @return Result produced by the size operation.
     */
    size_t size() const { return size_; }

private:
    void removeOldest()
    {
        if (head_ == nullptr) return;
        AccessRecord* old = head_;
        head_ = old->next;
        if (head_ != nullptr) head_->prev = nullptr;
        else                  tail_ = nullptr;
        delete old;
        size_--;
    }

    AccessRecord* head_ = nullptr;
    AccessRecord* tail_ = nullptr;
    size_t        size_ = 0;
    const size_t  capacity_;
};

// ======================================================
// 8. PRESCRIPTION AND BOX SLOTS
// ======================================================
/**
 * @brief Enumerates the logical state of a medicine box slot.
 */
enum class SlotStatus : uint8_t { Empty, Await, Loaded, Dispensed };

/**
 * @brief Stores prescription and occupancy state for one medicine box.
 */
struct BoxSlot
{
    int        box        = 0;
    String     medicine   = "-";
    bool       prescribed = false;
    SlotStatus status     = SlotStatus::Empty;

    const char* statusName() const
    {
        switch (status)
        {
            case SlotStatus::Await:     return "AWAIT";
            case SlotStatus::Loaded:    return "LOADED";
            case SlotStatus::Dispensed: return "DISPENSED";
            default:                    return "EMPTY";
        }
    }
};

/**
 * @brief Stores a patient name and the medicine assigned to each box.
 */
struct Prescription
{
    String patient = "";
    String medicine[BOX_COUNT + 1];          // index 1..3, "-" = none
    bool   active  = false;

    /**
     * @brief Performs the has box operation for SlotStatus.
     *
     * @param box Input/output parameter used by this operation.
     *
     * @return Result produced by the has box operation.
     */
    bool hasBox(int box) const { return medicine[box].length() > 0 && medicine[box] != "-"; }
};


// ######################################################
//              OBSERVER: EVENTS FOR THE GUI
// ######################################################

/**
 * @brief Interface implemented by objects that consume published dispenser events.
 */
class EventListener
{
public:
    /**
     * @brief Performs the event listener operation for SlotStatus.
     *
     * @return Result produced by the event listener operation.
     */
    virtual ~EventListener() {}
    virtual void onEvent(const String& event) = 0;
};

/**
 * @brief Simple publish/subscribe event dispatcher used by the firmware.
 */
class EventBus
{
public:
    ~EventBus()
    {
        while (head_ != nullptr)
        {
            Node* next = head_->next;
            delete head_;
            head_ = next;
        }
    }

    /**
     * @brief Registers an event listener with the event bus.
     *
     * @param listener Input/output parameter used by this operation.
     */
    void subscribe(EventListener* listener) { head_ = new Node{ listener, head_ }; }

    void publish(const String& event) const
    {
        for (Node* n = head_; n != nullptr; n = n->next) n->listener->onEvent(event);
    }

private:
    /**
     * @brief Defines the Node struct used by the dispenser firmware.
     */
    struct Node { EventListener* listener; Node* next; };
    Node* head_ = nullptr;
};

/**
 * @brief Event listener that forwards dispenser events to USB Serial.
 */
class SerialReporter : public EventListener
{
public:
    void onEvent(const String& event) override
    {
        Serial.print("EVT ");
        Serial.println(event);
    }
};


// ######################################################
//              DEVICES (inheritance from Device)
// ######################################################

/**
 * @brief Abstract base class for hardware devices managed by the dispenser.
 */
class Device
{
public:
    /**
     * @brief Performs the evice operation for SlotStatus.
     *
     * @param name Input/output parameter used by this operation.
     * @param name Input/output parameter used by this operation.
     * @param bus Input/output parameter used by this operation.
     *
     * @return Result produced by the evice operation.
     */
    Device(const char* name, EventBus* bus) : name_(name), bus_(bus) {}
    /**
     * @brief Performs the device operation for SlotStatus.
     *
     * @return Result produced by the device operation.
     */
    virtual ~Device() {}
    virtual void begin() = 0;
    /**
     * @brief Performs the name operation for SlotStatus.
     *
     * @return Result produced by the name operation.
     */
    const char* name() const { return name_; }

protected:
    /**
     * @brief Publishes an event to all registered listeners.
     *
     * @param event Input/output parameter used by this operation.
     */
    void publish(const String& event) const { if (bus_ != nullptr) bus_->publish(event); }

    const char* name_;
    EventBus*   bus_;
};

// ---------- Box servo ----------
/**
 * @brief Controls one medicine-box servo and tracks whether the box is open.
 */
class BoxServo : public Device
{
public:
    BoxServo(const char* name, uint8_t pin, int box, EventBus* bus)
        : Device(name, bus), pin_(pin), box_(box) {}

    void begin() override
    {
        servo_.attach(pin_, SERVO_MIN_US, SERVO_MAX_US);
        servo_.write(SERVO_CLOSED);
    }

    void open()
    {
        servo_.write(SERVO_OPEN);
        open_ = true;
        /**
         * @brief Performs the ublish operation for SlotStatus.
         *
         * @param box_ Input/output parameter used by this operation.
         *
         * @return Result produced by the ublish operation.
         */
        publish("OPEN " + String(box_));
    }

    void close()
    {
        servo_.write(SERVO_CLOSED);
        open_ = false;
        /**
         * @brief Performs the ublish operation for SlotStatus.
         *
         * @param box_ Input/output parameter used by this operation.
         *
         * @return Result produced by the ublish operation.
         */
        publish("CLOSE " + String(box_));
    }

    // Small movement used by the start-up self-check
    void wiggle()
    {
        servo_.write(45);
        /**
         * @brief Performs the elay operation for SlotStatus.
         *
         * @return Result produced by the elay operation.
         */
        delay(350);
        servo_.write(SERVO_CLOSED);
        /**
         * @brief Performs the elay operation for SlotStatus.
         *
         * @return Result produced by the elay operation.
         */
        delay(350);
    }

    /**
     * @brief Returns whether the medicine box is currently commanded open.
     *
     * @return Result produced by the is open operation.
     */
    bool isOpen() const { return open_; }
    /**
     * @brief Returns the medicine-box number associated with this object.
     *
     * @return Result produced by the box operation.
     */
    int  box()    const { return box_; }

private:
    Servo   servo_;
    uint8_t pin_;
    int     box_;
    bool    open_ = false;
};

// ---------- IR sensor (one per box) ----------
/**
 * @brief Debounced digital medicine-presence sensor for one box.
 */
class IrSensor : public Device
{
public:
    IrSensor(const char* name, uint8_t pin, int box, EventBus* bus)
        : Device(name, bus), pin_(pin), box_(box) {}

    void begin() override
    {
        /**
         * @brief Performs the in mode operation for SlotStatus.
         *
         * @param pin_ Input/output parameter used by this operation.
         * @param INPUT_PULLUP Input/output parameter used by this operation.
         *
         * @return Result produced by the in mode operation.
         */
        pinMode(pin_, INPUT_PULLUP);
        stable_ = readRaw();
        candidate_ = stable_;
    }

    bool readRaw() const
    {
        bool level = digitalRead(pin_) == HIGH;
        return IR_ACTIVE_LOW ? !level : level;
    }

    // Debounce: a new reading must stay the same for IR_DEBOUNCE ms
    void update()
    {
        bool raw = readRaw();
        unsigned long now = millis();

        if (raw != candidate_)
        {
            candidate_ = raw;
            changedAt_ = now;
        }
        else if (raw != stable_ && now - changedAt_ >= IR_DEBOUNCE)
        {
            stable_ = raw;
            /**
             * @brief Performs the ublish operation for SlotStatus.
             *
             * @param stable_ Input/output parameter used by this operation.
             *
             * @return Result produced by the ublish operation.
             */
            publish("IR " + String(box_) + (stable_ ? " 1" : " 0"));
        }
    }

    /**
     * @brief Returns whether the IR sensor currently detects medicine.
     *
     * @return Result produced by the present operation.
     */
    bool present() const { return stable_; }   // true = medicine detected
    /**
     * @brief Returns the medicine-box number associated with this object.
     *
     * @return Result produced by the box operation.
     */
    int  box()     const { return box_; }

private:
    uint8_t       pin_;
    int           box_;
    bool          stable_    = false;
    bool          candidate_ = false;
    unsigned long changedAt_ = 0;
};

// ---------- LCD ----------
/**
 * @brief Wrapper for the 16x2 I2C LCD with event mirroring to the GUI.
 */
class LcdDisplay : public Device
{
public:
    LcdDisplay(const char* name, uint8_t address, EventBus* bus)
        : Device(name, bus), address_(address), lcd_(address, 16, 2) {}

    void begin() override
    {
        Wire.setSDA(LCD_SDA);
        Wire.setSCL(LCD_SCL);
        Wire.begin();
        lcd_.init();
        lcd_.backlight();
    }

    bool detected() const
    {
        Wire.beginTransmission(address_);
        return Wire.endTransmission() == 0;
    }

    void show(const String& line1, const String& line2)
    {
        String a = line1.substring(0, 16);
        String b = line2.substring(0, 16);
        if (a == line1_ && b == line2_) return;    // nothing changed
        line1_ = a;
        line2_ = b;

        lcd_.clear();
        lcd_.setCursor(0, 0);
        lcd_.print(line1_);
        lcd_.setCursor(0, 1);
        lcd_.print(line2_);

        /**
         * @brief Performs the ublish operation for SlotStatus.
         *
         * @param line2_ Input/output parameter used by this operation.
         *
         * @return Result produced by the ublish operation.
         */
        publish("LCD " + line1_ + "|" + line2_);
    }

    /**
     * @brief Publishes the current display contents without changing them.
     */
    void republish() const { publish("LCD " + line1_ + "|" + line2_); }

private:
    uint8_t           address_;
    LiquidCrystal_I2C lcd_;
    String            line1_ = "";
    String            line2_ = "";
};


// ######################################################
//            INPUT SOURCES (inheritance from InputSource)
// ######################################################

/**
 * @brief Abstract interface for sources that generate normalized input events.
 */
class InputSource
{
public:
    /**
     * @brief Performs the input source operation for SlotStatus.
     *
     * @return Result produced by the input source operation.
     */
    virtual ~InputSource() {}
    /**
     * @brief Initializes the object and its associated hardware or runtime resources.
     */
    virtual void begin() {}
    virtual void poll(Queue<InputEvent>& queue) = 0;
};

// ---------- Keypad (custom scanner) ----------
/**
 * @brief Scans the 4x4 keypad and converts stable key presses into input events.
 */
class KeypadInput : public InputSource
{
public:
    void begin() override
    {
        for (byte r = 0; r < ROWS; r++) pinMode(ROW_PINS[r], INPUT_PULLUP);
        for (byte c = 0; c < COLS; c++) pinMode(COL_PINS[c], INPUT);
    }

    void poll(Queue<InputEvent>& queue) override
    {
        char raw = scanRaw();
        unsigned long now = millis();

        /**
         * @brief Performs the f operation for SlotStatus.
         *
         * @param raw Input/output parameter used by this operation.
         *
         * @return Result produced by the f operation.
         */
        if (raw != lastRaw_) { lastRaw_ = raw; lastChange_ = now; }

        if (now - lastChange_ >= DEBOUNCE_MS && raw != stableKey_)
        {
            stableKey_ = raw;
            if (stableKey_ != 0)
            {
                InputEvent e;
                e.type = InputType::Key;
                e.key  = stableKey_;
                queue.push(e);
            }
        }
    }

    char scanRaw() const
    {
        char found = 0;
        int  count = 0;

        for (byte c = 0; c < COLS; c++)
        {
            /**
             * @brief Performs the in mode operation for SlotStatus.
             *
             * @param c Input/output parameter used by this operation.
             * @param OUTPUT Input/output parameter used by this operation.
             *
             * @return Result produced by the in mode operation.
             */
            pinMode(COL_PINS[c], OUTPUT);
            /**
             * @brief Performs the igital write operation for SlotStatus.
             *
             * @param c Input/output parameter used by this operation.
             * @param LOW Input/output parameter used by this operation.
             *
             * @return Result produced by the igital write operation.
             */
            digitalWrite(COL_PINS[c], LOW);
            /**
             * @brief Performs the elay microseconds operation for SlotStatus.
             *
             * @return Result produced by the elay microseconds operation.
             */
            delayMicroseconds(20);

            for (byte r = 0; r < ROWS; r++)
            {
                /**
                 * @brief Performs the f operation for SlotStatus.
                 *
                 * @param r Input/output parameter used by this operation.
                 *
                 * @return Result produced by the f operation.
                 */
                if (digitalRead(ROW_PINS[r]) == LOW) { found = KEYS[r][c]; count++; }
            }

            /**
             * @brief Performs the in mode operation for SlotStatus.
             *
             * @param c Input/output parameter used by this operation.
             * @param INPUT Input/output parameter used by this operation.
             *
             * @return Result produced by the in mode operation.
             */
            pinMode(COL_PINS[c], INPUT);
            /**
             * @brief Performs the elay microseconds operation for SlotStatus.
             *
             * @return Result produced by the elay microseconds operation.
             */
            delayMicroseconds(20);
        }
        return (count == 1) ? found : 0;
    }

private:
    static const byte ROWS = 4;
    static const byte COLS = 4;
    static constexpr unsigned long DEBOUNCE_MS = 30;
    static constexpr byte ROW_PINS[ROWS] = { 0, 1, 2, 3 };
    static constexpr byte COL_PINS[COLS] = { 12, 13, 14, 15 };
    static constexpr char KEYS[ROWS][COLS] =
    {
        { '1', '2', '3', 'A' },
        { '4', '5', '6', 'B' },
        { '7', '8', '9', 'C' },
        { '*', '0', '#', 'D' }
    };

    char          lastRaw_    = 0;
    char          stableKey_  = 0;
    unsigned long lastChange_ = 0;
};

// ---------- RFID ----------
/**
 * @brief Reads MFRC522 RFID cards and produces card input events.
 */
class RfidInput : public InputSource
{
public:
    /**
     * @brief Performs the fid input operation for SlotStatus.
     *
     * @param reader Input/output parameter used by this operation.
     *
     * @return Result produced by the fid input operation.
     */
    explicit RfidInput(MFRC522* reader) : reader_(reader) {}

    void begin() override
    {
        SPI.setRX(RFID_MISO);
        SPI.setCS(RFID_SS);
        SPI.setSCK(RFID_SCK);
        SPI.setTX(RFID_MOSI);
        SPI.begin();
        reader_->PCD_Init();
    }

    /**
     * @brief Enables or disables the RFID input source.
     *
     * @param enabled Input/output parameter used by this operation.
     */
    void setEnabled(bool enabled) { enabled_ = enabled; }

    bool detected() const
    {
        byte v = reader_->PCD_ReadRegister(MFRC522::VersionReg);
        return !(v == 0x00 || v == 0xFF);
    }

    void poll(Queue<InputEvent>& queue) override
    {
        if (!enabled_) return;
        if (!reader_->PICC_IsNewCardPresent()) return;
        if (!reader_->PICC_ReadCardSerial())   return;

        String uid = "";
        for (byte i = 0; i < reader_->uid.size; i++)
        {
            if (reader_->uid.uidByte[i] < 0x10) uid += "0";
            uid += String(reader_->uid.uidByte[i], HEX);
        }
        uid.toUpperCase();

        reader_->PICC_HaltA();
        reader_->PCD_StopCrypto1();

        InputEvent e;
        e.type = InputType::Card;
        e.text = uid;
        queue.push(e);
    }

private:
    MFRC522* reader_;
    bool     enabled_ = false;
};

// ---------- USB serial commands ----------
/**
 * @brief Receives and parses commands from the doctor GUI over USB Serial.
 */
class SerialInput : public InputSource
{
public:
    void poll(Queue<InputEvent>& queue) override
    {
        while (Serial.available() > 0)
        {
            char c = (char)Serial.read();
            if (c == '\n' || c == '\r')
            {
                /**
                 * @brief Performs the f operation for SlotStatus.
                 *
                 * @param length Input/output parameter used by this operation.
                 *
                 * @return Result produced by the f operation.
                 */
                if (line_.length() > 0) { parse(line_, queue); line_ = ""; }
            }
            else if (line_.length() < 120)
            {
                line_ += c;
            }
        }
    }

private:
    void parse(String cmd, Queue<InputEvent>& queue)
    {
        cmd.trim();
        if (cmd.length() == 0) return;

        String upper = cmd;
        upper.toUpperCase();

        InputEvent e;
        e.text = cmd;

        if      (upper == "HELLO")     e.type = InputType::Hello;
        else if (upper == "STATUS")    e.type = InputType::Status;
        else if (upper == "PING")      e.type = InputType::Ping;
        else if (upper == "HISTORY")   e.type = InputType::History;
        else if (upper == "CLEAR")     e.type = InputType::Clear;
        else if (upper == "EXIT")      e.type = InputType::Exit;
        else if (upper == "DOCLOGOUT") e.type = InputType::DocLogout;
        else if (upper.startsWith("DOCLOGIN "))
        {
            e.type = InputType::DocLogin;
            e.text = cmd.substring(9);
            e.text.trim();
        }
        else if (upper.startsWith("RX "))
        {
            e.type = InputType::Prescription;
            e.text = cmd.substring(3);          // keep original letter case
            e.text.trim();
        }
        else if (upper.startsWith("SELECT "))
        {
            e.type = InputType::SelectBox;
            e.box  = upper.substring(7).toInt();
        }
        else if (upper.startsWith("PIN "))
        {
            e.type = InputType::Pin;
            e.text = upper.substring(4);
            e.text.trim();
        }
        else
        {
            e.type = InputType::Unknown;
        }

        queue.push(e);
    }

    String line_ = "";
};


// ######################################################
//        STRATEGY: AUTHENTICATORS (inheritance)
// ######################################################

/**
 * @brief Strategy interface for credential authentication.
 */
class Authenticator
{
public:
    /**
     * @brief Performs the uthenticator operation for SlotStatus.
     *
     * @param users Input/output parameter used by this operation.
     *
     * @return Result produced by the uthenticator operation.
     */
    explicit Authenticator(const UserRegistry* users) : users_(users) {}
    /**
     * @brief Performs the authenticator operation for SlotStatus.
     *
     * @return Result produced by the authenticator operation.
     */
    virtual ~Authenticator() {}
    virtual User*       authenticate(const String& credential) const = 0;
    virtual const char* failText() const = 0;

protected:
    const UserRegistry* users_;
};

/**
 * @brief Authenticates users using a numeric PIN.
 */
class PinAuthenticator : public Authenticator
{
public:
    /**
     * @brief Performs the in authenticator operation for SlotStatus.
     *
     * @param users Input/output parameter used by this operation.
     *
     * @return Result produced by the in authenticator operation.
     */
    explicit PinAuthenticator(const UserRegistry* users) : Authenticator(users) {}

    User* authenticate(const String& pin) const override
    {
        if (pin.length() != PIN_LENGTH) return nullptr;
        return users_->findByPin(pin);
    }

    /**
     * @brief Returns the authentication failure message for this authenticator.
     *
     * @return Result produced by the fail text operation.
     */
    const char* failText() const override { return "Invalid PIN"; }
};

/**
 * @brief Authenticates users using an RFID card UID.
 */
class RfidAuthenticator : public Authenticator
{
public:
    /**
     * @brief Performs the fid authenticator operation for SlotStatus.
     *
     * @param users Input/output parameter used by this operation.
     *
     * @return Result produced by the fid authenticator operation.
     */
    explicit RfidAuthenticator(const UserRegistry* users) : Authenticator(users) {}

    /**
     * @brief Validates the supplied credential and returns the matching user when successful.
     *
     * @param uid Input/output parameter used by this operation.
     *
     * @return Result produced by the authenticate operation.
     */
    User* authenticate(const String& uid) const override { return users_->findByUid(uid); }
    /**
     * @brief Returns the authentication failure message for this authenticator.
     *
     * @return Result produced by the fail text operation.
     */
    const char* failText() const override { return "Unknown Card"; }
};


// ######################################################
//              STATE PATTERN - one class per phase
// ######################################################

/**
 * @brief Singleton controller coordinating hardware, protocol, authentication and workflow state.
 *
 * This class is the central coordinator and owns the hardware devices,
 * user registry, queues, prescription data and state objects.
 */
class Dispenser;

/**
 * @brief Abstract base class for the medicine-dispenser state machine.
 */
class DispenserState
{
public:
    /**
     * @brief Performs the dispenser state operation for SlotStatus.
     *
     * @return Result produced by the dispenser state operation.
     */
    virtual ~DispenserState() {}
    virtual const char* mode() const = 0;                       // sent to the GUI
    virtual void enter(Dispenser& d) = 0;                       // phase starts
    virtual void handle(Dispenser& d, const InputEvent& e) = 0; // key / card / PC input
    /**
     * @brief Updates the object's state from current inputs and timing conditions.
     *
     * @param d Input/output parameter used by this operation.
     */
    virtual void update(Dispenser& d) { (void)d; }              // called every loop
    /**
     * @brief Refreshes the LCD for the current dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    virtual void redraw(Dispenser& d) { (void)d; }              // repaint the LCD
    /**
     * @brief Reports whether the current state is physically moving a medicine box.
     *
     * @return Result produced by the moving operation.
     */
    virtual bool moving() const { return false; }               // a box is open
};

// ---------- 1. Idle: waiting for a prescription ----------
/**
 * @brief State used while no prescription is active.
 */
class IdleState : public DispenserState
{
public:
    /**
     * @brief Returns the text identifier of the current dispenser state.
     *
     * @return Result produced by the mode operation.
     */
    const char* mode() const override { return "IDLE"; }
    /**
     * @brief Performs actions required when entering this dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    void enter(Dispenser& d) override;
    /**
     * @brief Handles an input event while this dispenser state is active.
     *
     * @param d Input/output parameter used by this operation.
     * @param e Input/output parameter used by this operation.
     */
    void handle(Dispenser& d, const InputEvent& e) override;
    /**
     * @brief Refreshes the LCD for the current dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    void redraw(Dispenser& d) override;
};

// ---------- Code entry (base for refill / reset passcodes) ----------
// Template Method: handle() collects the digits and checks the code,
// subclasses decide what happens when the code is correct.
/**
 * @brief Shared base state for refill/reset code entry.
 */
class CodeEntryState : public DispenserState
{
public:
    /**
     * @brief Performs actions required when entering this dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    void enter(Dispenser& d) override;
    /**
     * @brief Handles an input event while this dispenser state is active.
     *
     * @param d Input/output parameter used by this operation.
     * @param e Input/output parameter used by this operation.
     */
    void handle(Dispenser& d, const InputEvent& e) override;
    /**
     * @brief Refreshes the LCD for the current dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    void redraw(Dispenser& d) override;

protected:
    virtual const char* title() const = 0;          // LCD line 1
    virtual void onCodeAccepted(Dispenser& d) = 0;  // what to do next
};

/**
 * @brief Authorizes the start of a refill cycle.
 */
class RefillStartState : public CodeEntryState
{
public:
    /**
     * @brief Returns the text identifier of the current dispenser state.
     *
     * @return Result produced by the mode operation.
     */
    const char* mode() const override { return "REFILL_AUTH"; }
protected:
    /**
     * @brief Returns the LCD title used by this code-entry state.
     *
     * @return Result produced by the title operation.
     */
    const char* title() const override { return "REFILLING"; }
    /**
     * @brief Handles a successfully entered refill/reset code.
     *
     * @param d Input/output parameter used by this operation.
     */
    void onCodeAccepted(Dispenser& d) override;
};

/**
 * @brief Authorizes completion of a refill cycle.
 */
class RefillFinishState : public CodeEntryState
{
public:
    /**
     * @brief Returns the text identifier of the current dispenser state.
     *
     * @return Result produced by the mode operation.
     */
    const char* mode() const override { return "REFILL_DONE"; }
protected:
    /**
     * @brief Returns the LCD title used by this code-entry state.
     *
     * @return Result produced by the title operation.
     */
    const char* title() const override { return "Refill complete"; }
    /**
     * @brief Handles a successfully entered refill/reset code.
     *
     * @param d Input/output parameter used by this operation.
     */
    void onCodeAccepted(Dispenser& d) override;
};

/**
 * @brief Authorizes opening all boxes for reset/emptying.
 */
class ResetStartState : public CodeEntryState
{
public:
    /**
     * @brief Returns the text identifier of the current dispenser state.
     *
     * @return Result produced by the mode operation.
     */
    const char* mode() const override { return "RESET_AUTH"; }
protected:
    /**
     * @brief Returns the LCD title used by this code-entry state.
     *
     * @return Result produced by the title operation.
     */
    const char* title() const override { return "RESET MODE"; }
    /**
     * @brief Handles a successfully entered refill/reset code.
     *
     * @param d Input/output parameter used by this operation.
     */
    void onCodeAccepted(Dispenser& d) override;
};

// ---------- 5. Complete: every prescribed medicine has been dispensed ----------
// No box can be selected. The code refills the same prescription;
// a new prescription from the doctor also leaves this state.
/**
 * @brief State entered after every prescribed medicine has been dispensed.
 */
class CompleteState : public CodeEntryState
{
public:
    /**
     * @brief Returns the text identifier of the current dispenser state.
     *
     * @return Result produced by the mode operation.
     */
    const char* mode() const override { return "COMPLETE"; }
    /**
     * @brief Handles an input event while this dispenser state is active.
     *
     * @param d Input/output parameter used by this operation.
     * @param e Input/output parameter used by this operation.
     */
    void handle(Dispenser& d, const InputEvent& e) override;
    /**
     * @brief Refreshes the LCD for the current dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    void redraw(Dispenser& d) override;
protected:
    /**
     * @brief Returns the LCD title used by this code-entry state.
     *
     * @return Result produced by the title operation.
     */
    const char* title() const override { return "All dispensed"; }
    /**
     * @brief Handles a successfully entered refill/reset code.
     *
     * @param d Input/output parameter used by this operation.
     */
    void onCodeAccepted(Dispenser& d) override;
};

// ---------- 3. Refill: open prescribed boxes one by one ----------
/**
 * @brief Sequentially opens prescribed boxes and waits for medicine loading.
 */
class RefillState : public DispenserState
{
public:
    /**
     * @brief Returns the text identifier of the current dispenser state.
     *
     * @return Result produced by the mode operation.
     */
    const char* mode() const override { return "REFILL"; }
    /**
     * @brief Performs actions required when entering this dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    void enter(Dispenser& d) override;
    /**
     * @brief Handles an input event while this dispenser state is active.
     *
     * @param d Input/output parameter used by this operation.
     * @param e Input/output parameter used by this operation.
     */
    void handle(Dispenser& d, const InputEvent& e) override { (void)d; (void)e; }
    /**
     * @brief Updates the object's state from current inputs and timing conditions.
     *
     * @param d Input/output parameter used by this operation.
     */
    void update(Dispenser& d) override;
    /**
     * @brief Refreshes the LCD for the current dispenser state.
     *
     * @param d Input/output parameter used by this operation.
     */
    void redraw(Dispenser& d) override;
    /**
     * @brief Reports whether the current state is physically moving a medicine box.
     *
     * @return Result produced by the moving operation.
     */
    bool moving() const override { return true; }

private:
    /**
     * @brief Advances the refill sequence to the next prescribed medicine box.
     *
     * @param d Input/output parameter used by this operation.
     */
    void nextBox(Dispenser& d);

    int           box_        = 0;
    unsigned long detectedAt_ = 0;
};

